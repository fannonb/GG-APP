# API base URL (NestJS backend)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Use mock data layer when true (default). Set false when backend is available.
VITE_USE_MOCK_API=true

# Google OAuth client ID (patient login)
VITE_GOOGLE_CLIENT_ID=

# Web Push VAPID public key (from backend)
VITE_VAPID_PUBLIC_KEY=
