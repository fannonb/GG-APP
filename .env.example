# API base URL (NestJS backend)
# Local:   http://localhost:3000/api/v1
# Railway: https://api-production-<service>.up.railway.app/api/v1
# Custom domain (once DNS is cut over): https://api.gatewayglobal.africa/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Use mock data layer when true (default). Set false when backend is available.
VITE_USE_MOCK_API=false

# Google OAuth client ID (patient login)
VITE_GOOGLE_CLIENT_ID=

# Web Push VAPID public key (from backend)
VITE_VAPID_PUBLIC_KEY=

# Private admin portal path/token. Production sets a long random value; the
# backend must have the matching ADMIN_PORTAL_PATH/ADMIN_PORTAL_TOKEN.
VITE_ADMIN_PORTAL_PATH=/admin
VITE_ADMIN_PORTAL_TOKEN=
