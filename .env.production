# Production build defaults, read by Vite for `vite build` on any host (Vercel,
# local, CI). Only public values belong here: everything VITE_* is inlined into
# the shipped bundle. Values set by the host's own environment (e.g. Railway
# build args in the Dockerfile) take priority over this file.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=https://api.gatewayglobal.africa/api/v1
VITE_ADMIN_PORTAL_PATH=/admin
# Public OAuth client ID — safe to ship in the bundle (no secret). Without it
# the "Continue with Google" button reports that sign-in is not configured.
VITE_GOOGLE_CLIENT_ID=335540055294-b0st0c8i3f934rnaj3aom67vjd2id301.apps.googleusercontent.com
