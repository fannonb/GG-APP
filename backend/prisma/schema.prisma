generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  SP
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum CreditStatus {
  APPROVED
  PENDING
  REJECTED
  NOT_APPLIED
}

enum CreditApplicationType {
  INITIAL
  INCREASE
}

enum CreditApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum ProviderCategory {
  DOCTOR
  PHARMACY
  LABORATORY
  RADIOLOGY
  HOSPITAL
  CLINIC
}

enum ProviderOpenStatus {
  OPEN
  CLOSED
}

enum ProviderLifecycleStatus {
  ACTIVE
  SUSPENDED
}

enum ProviderApplicationStatus {
  PENDING
  INFO_REQUESTED
  APPROVED
  REJECTED
}

enum ProviderApplicationDocumentKind {
  LOGO
  LICENSE
  SUPPORTING
  INVOICE_PDF
}

enum ProviderPayoutMethod {
  MPESA
  BANK
  MOBILE_MONEY
}

enum ProviderPayoutAccountStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AppointmentMode {
  HOME_VISIT
  IN_PERSON
  TELEHEALTH
}

enum NotificationType {
  PAYMENT
  INVOICE
  APPOINTMENT
  CREDIT
  SYSTEM
  PRESCRIPTION
  LEDGER
}

enum LedgerPinStatus {
  ACTIVE
  REVOKED
}

enum LedgerAuditAction {
  PIN_CREATED
  PIN_ROTATED
  PIN_REVOKED
  UNLOCK_SUCCESS
  UNLOCK_FAILED
  LEDGER_VIEWED
  GRANT_REVOKED
  GRANT_EXPIRED
}

enum PrescriptionRequestStatus {
  SUBMITTED
  QUOTED
  ACCEPTED
  PREPARING
  READY
  FULFILLED
  CANCELLED
  REJECTED
}

enum PrescriptionFulfillmentMode {
  PICKUP
  DELIVERY
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  AUTHORIZED
}

enum InvoiceStatus {
  PENDING_AUTH
  AUTHORIZED
  PAID
  DISPUTED
  REJECTED
}

enum ServiceForType {
  SELF
  BENEFICIARY
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                String                   @id @default(uuid())
  email             String                   @unique
  passwordHash      String
  paymentPinHash    String?
  role              UserRole
  status            UserStatus               @default(PENDING_VERIFICATION)
  phone             String?
  country           String?
  emailVerifiedAt   DateTime?
  googleId          String?                  @unique
  authProvider      AuthProvider             @default(LOCAL)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  patientProfile    PatientProfile?
  providerRecord    Provider?                @relation("ProviderAuthUser")
  providerApplications ProviderApplication[]
  providerVisits    ProviderVisit[]          @relation("ProviderVisitPatient")
  sessionAudits     ProviderSessionAudit[]
  notifications     Notification[]
  emailVerifications EmailVerificationToken[]
  appointments      Appointment[]
  transactions      Transaction[]
  invoices          Invoice[]
  auditLogs         AuditLog[]               @relation("AuditActor")
  providerReviews   ProviderReview[]
  creditApplications CreditApplication[]
  reviewedCreditApplications CreditApplication[] @relation("CreditApplicationReviewer")
  prescriptionRequests PrescriptionRequest[]
  ledgerPin         LedgerPin?
  ledgerGrants      LedgerAccessGrant[] @relation("LedgerGrantPatient")
  ledgerAudits      LedgerAccessAudit[] @relation("LedgerAuditPatient")
}

model PatientProfile {
  userId              String        @id
  firstName           String
  lastName            String
  dateOfBirth         DateTime
  countryCode         String
  /// Where the patient currently lives (e.g. "Kenya" or "Australia")
  residenceCountry    String?
  /// True when residence is outside Kenya, Zimbabwe, or Zambia
  residesAbroad       Boolean       @default(false)
  nationalIdEncrypted String
  nationalIdLast4     String
  creditLimit         Decimal       @default(0) @db.Decimal(12, 2)
  creditUsed          Decimal       @default(0) @db.Decimal(12, 2)
  creditAvailable     Decimal       @default(0) @db.Decimal(12, 2)
  creditStatus        CreditStatus  @default(NOT_APPLIED)
  financePartnerId      String?
  creditAccountRef      String?
  beneficiariesEnabled  Boolean       @default(false)
  memberSince           DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiaries         Beneficiary[]
}

model CreditApplication {
  id               String                  @id @default(cuid())
  reference        String                  @unique
  patientUserId    String
  type             CreditApplicationType
  status           CreditApplicationStatus @default(SUBMITTED)
  financePartnerId String
  employment       String
  monthlyIncome    Decimal                 @db.Decimal(12, 2)
  requestedAmount  Decimal                 @db.Decimal(12, 2)
  approvedAmount   Decimal?                @db.Decimal(12, 2)
  reason           String?
  notes            String?
  declineReason    String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  submittedAt      DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  patient          User                    @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  reviewedBy       User?                   @relation("CreditApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([patientUserId, submittedAt])
  @@index([status, submittedAt])
}

model Beneficiary {
  id                  String         @id @default(cuid())
  patientUserId       String
  name                String
  relation            String
  dateOfBirth         DateTime
  /// Operating country where this beneficiary resides (KE | ZW | ZM)
  countryCode         String
  nationalIdEncrypted String?
  nationalIdLast4     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  patientProfile      PatientProfile @relation(fields: [patientUserId], references: [userId], onDelete: Cascade)
  appointments        Appointment[]
  prescriptionRequests PrescriptionRequest[]
  visits              ProviderVisit[]
}

model Provider {
  id                       Int                         @id @default(autoincrement())
  authUserId               String?                     @unique
  applicationId            String?                     @unique
  slug                     String                      @unique
  name                     String
  category                 ProviderCategory
  categories               String[]                    @default([])
  description              String?
  about                    String?
  rating                   Decimal                     @default(0) @db.Decimal(3, 2)
  reviewCount              Int                         @default(0)
  distanceKm               Decimal?                    @db.Decimal(5, 2)
  status                   ProviderOpenStatus          @default(OPEN)
  lifecycleStatus          ProviderLifecycleStatus     @default(ACTIVE)
  hours                    String
  hoursJson                Json?
  phone                    String
  address                  String
  license                  String?
  logoUrl                  String?
  country                  String?
  tags                     Json?
  languages                Json?
  establishedYear          Int?
  joinedAt                 DateTime                    @default(now())
  lat                      Decimal?                    @db.Decimal(10, 6)
  lng                      Decimal?                    @db.Decimal(10, 6)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  authUser                 User?                       @relation("ProviderAuthUser", fields: [authUserId], references: [id], onDelete: SetNull)
  application              ProviderApplication?        @relation("ProviderApproval", fields: [applicationId], references: [id], onDelete: SetNull)
  notificationPreference   ProviderNotificationPreference?
  payoutAccounts           ProviderPayoutAccount[]
  services                 ProviderService[]
  appointments             Appointment[]
  transactions             Transaction[]
  invoices                 Invoice[]
  visits                   ProviderVisit[]
  reviews                  ProviderReview[]
  prescriptionRequests     PrescriptionRequest[]
  ledgerGrants             LedgerAccessGrant[]
  ledgerAudits             LedgerAccessAudit[]
}

model ProviderApplication {
  id                   String                       @id @default(cuid())
  userId               String
  status               ProviderApplicationStatus    @default(PENDING)
  practiceName         String
  email                String
  emailSecondary       String?
  phone                String
  country              String
  locationLabel        String?
  address              String
  city                 String?
  region               String?
  serviceTypes         Json
  licenseNumber        String
  openingHours         Json
  payoutMethod         ProviderPayoutMethod
  payoutSummary        String?
  payoutDetails        Json?
  decisionNote         String?
  lat                  Decimal?                     @db.Decimal(10, 6)
  lng                  Decimal?                     @db.Decimal(10, 6)
  submittedAt          DateTime                     @default(now())
  decidedAt            DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             Provider?                    @relation("ProviderApproval")
  documents            ProviderApplicationDocument[]
}

model ProviderApplicationDocument {
  id           String                          @id @default(cuid())
  applicationId String
  kind         ProviderApplicationDocumentKind
  originalName String
  mimeType     String
  sizeBytes    Int
  displaySize  String
  storageKey   String
  uploadedAt   DateTime                        @default(now())
  application  ProviderApplication             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ProviderNotificationPreference {
  id                   String   @id @default(cuid())
  providerId           Int      @unique
  newAppointmentEmail  Boolean  @default(true)
  paymentEmail         Boolean  @default(true)
  invoiceEmail         Boolean  @default(true)
  disputeEmail         Boolean  @default(true)
  systemEmail          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  provider             Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderPayoutAccount {
  id            String                      @id @default(cuid())
  providerId    Int
  method        ProviderPayoutMethod
  accountNumber String
  accountName   String
  country       String
  isDefault     Boolean                     @default(false)
  status        ProviderPayoutAccountStatus @default(ACTIVE)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  provider      Provider                    @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderVisit {
  id            String   @id @default(cuid())
  providerId    Int
  patientUserId String
  appointmentId String?
  beneficiaryId String?
  diagnosis     String?
  treatment     String?
  followUp      String?
  internalNote  String?
  services      Json?
  vitals        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  patient       User     @relation("ProviderVisitPatient", fields: [patientUserId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  @@index([patientUserId, createdAt])
}

model ProviderSessionAudit {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String   @unique
  deviceLabel   String
  locationLabel String?
  ipAddress     String?
  userAgent     String?
  lastSeenAt    DateTime @default(now())
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderService {
  id         Int      @id @default(autoincrement())
  providerId Int
  name       String
  createdAt  DateTime @default(now())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Appointment {
  id            String            @id @default(cuid())
  reference     String            @unique
  patientUserId String
  providerId    Int
  beneficiaryId String?
  service       String
  description   String
  date          DateTime
  timeLabel     String
  status        AppointmentStatus @default(REQUESTED)
  forSelf       Boolean           @default(true)
  mode          AppointmentMode   @default(IN_PERSON)
  address       String?
  duration      String?
  requestedAt          DateTime          @default(now())
  rescheduledAt        DateTime?
  cancellationReason   String?
  cancellationNote     String?
  attachments          Json?
  medicalHistory Json?
  allergies     Json?
  patient       User              @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  provider      Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  beneficiary   Beneficiary?      @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  visits        ProviderVisit[]
  invoices      Invoice[]
  prescriptionRequests PrescriptionRequest[] @relation("SourceAppointment")
}

model PrescriptionRequest {
  id                     String                      @id @default(cuid())
  reference              String                      @unique
  patientUserId          String
  providerId             Int
  beneficiaryId          String?
  sourceAppointmentId    String?
  status                 PrescriptionRequestStatus   @default(SUBMITTED)
  fulfillmentMode        PrescriptionFulfillmentMode @default(PICKUP)
  deliveryAddress        String?
  patientNotes           String?
  pharmacyNotes          String?
  prescriptionAttachment Json
  quotedItems            Json?
  quotedAmount           Decimal?                    @db.Decimal(12, 2)
  deliveryFee            Decimal?                    @db.Decimal(12, 2)
  quotedAt               DateTime?
  quoteReviewedAt        DateTime?
  acceptedAt             DateTime?
  declinedAt             DateTime?
  declineReason          String?
  readyAt                DateTime?
  fulfilledAt            DateTime?
  forSelf                Boolean                     @default(true)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  patient                User                        @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  provider               Provider                    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  beneficiary            Beneficiary?                @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  sourceAppointment      Appointment?                @relation("SourceAppointment", fields: [sourceAppointmentId], references: [id], onDelete: SetNull)
  invoice                Invoice?

  @@index([providerId, status])
  @@index([patientUserId, createdAt])
}

model Transaction {
  id                   String            @id @default(cuid())
  reference            String?           @unique
  patientUserId        String
  providerId           Int?
  invoiceId            String?           @unique
  amount               Decimal           @db.Decimal(12, 2)
  currency             String            @default("USD")
  status               TransactionStatus
  service              String
  providerNameSnapshot String?
  occurredAt           DateTime          @default(now())
  patient              User              @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  provider             Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  invoice              Invoice?          @relation("InvoiceTransaction", fields: [invoiceId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  screen    String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NewsArticle {
  id          Int        @id @default(autoincrement())
  title       String
  source      String
  tag         String
  body        String
  url         String?
  publishedAt DateTime
  status      NewsStatus @default(PUBLISHED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model NewsCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id                 String         @id @default(cuid())
  reference          String         @unique
  patientUserId      String
  providerId         Int
  appointmentId      String?
  status             InvoiceStatus  @default(PENDING_AUTH)
  issueDate          DateTime       @default(now())
  dueDate            DateTime
  amount             Decimal        @db.Decimal(12, 2)
  /// Amount debited from the patient's GG'APP allocation/credit wallet
  walletAmountPaid   Decimal?       @db.Decimal(12, 2)
  /// Remainder the patient settles directly with the provider (off-app)
  offAppAmountDue    Decimal?       @db.Decimal(12, 2)
  billedToName       String
  billedToNationalId String
  serviceForType     ServiceForType
  serviceForName     String
  serviceForRelation String?
  serviceForAge      Int?
  paymentAuthorizedAt DateTime?
  submittedAt        DateTime       @default(now())
  paidAt             DateTime?
  paymentRef         String?
  attachment         String?
  attachmentMetadata Json?
  diagnosis          String?
  treatment          String?
  followUp           String?
  internalNote       String?
  disputedAt         DateTime?
  adminApprovedAt    DateTime?
  disputeReason      String?
  disputeResolvedAt  DateTime?
  providerDisputeResponse String?
  providerDisputeProofMetadata Json?
  adminNote          String?
  rejectionReason    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  patient            User           @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  provider           Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  appointment        Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  prescriptionRequestId String?     @unique
  prescriptionRequest PrescriptionRequest? @relation(fields: [prescriptionRequestId], references: [id], onDelete: SetNull)
  transaction        Transaction?   @relation("InvoiceTransaction")
  lineItems          InvoiceLineItem[]
  reviews            ProviderReview[]
}

model ProviderReview {
  id            String   @id @default(cuid())
  reference     String   @unique
  providerId    Int
  patientUserId String
  invoiceId     String?
  rating        Int
  text          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  patient       User     @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([patientUserId, invoiceId])
  @@index([providerId])
}

model ReferenceSequence {
  type      String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([type, year])
}

model InvoiceLineItem {
  id        Int      @id @default(autoincrement())
  invoiceId String
  name      String
  amount    Decimal  @db.Decimal(12, 2)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
}

model LedgerPin {
  id            String          @id @default(cuid())
  patientUserId String          @unique
  pinHash       String
  status        LedgerPinStatus @default(ACTIVE)
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  rotatedAt     DateTime?
  revokedAt     DateTime?
  patient       User            @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
}

model LedgerAccessGrant {
  id            String    @id @default(cuid())
  patientUserId String
  providerId    Int
  unlockedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  patient       User      @relation("LedgerGrantPatient", fields: [patientUserId], references: [id], onDelete: Cascade)
  provider      Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([patientUserId, providerId])
  @@index([expiresAt])
}

model LedgerAccessAudit {
  id            String            @id @default(cuid())
  patientUserId String
  providerId    Int?
  action        LedgerAuditAction
  metadata      Json?
  createdAt     DateTime          @default(now())
  patient       User              @relation("LedgerAuditPatient", fields: [patientUserId], references: [id], onDelete: Cascade)
  provider      Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([patientUserId, createdAt])
}
