NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Canonical public app origin used for password-reset/deep links.
# Production: https://app.gatewayglobal.africa
APP_BASE_URL=http://localhost:5173

