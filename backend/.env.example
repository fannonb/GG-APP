NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://app.gatewayglobal.africa

# Canonical public app origin used for password-reset/deep links.
# Production: https://app.gatewayglobal.africa
APP_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://gg:gg@localhost:5432/gg_app?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Admin portal secret: the path the frontend mounts admin at, and the token
# admin login requests must send (X-Admin-Portal header). Admin refresh tokens
# expire much sooner than patient/provider sessions.
ADMIN_PORTAL_PATH=/admin
ADMIN_PORTAL_TOKEN=
ADMIN_REFRESH_TTL=60m

# When true, web clients (requests with X-Client: web) receive their refresh
# token in an httpOnly SameSite=Lax cookie instead of the JSON body, so the
# 30-day session handle never touches localStorage. Requires the API and web
# app to share a registrable domain (e.g. app. + api. example.com) and the
# web origin to be listed in CORS_ORIGIN.
SESSION_COOKIE_MODE=false

# Optional server-side allowlist for Google OAuth redirect URIs (comma
# separated, exact match). Empty disables the check - Google's own console
# allowlist still applies, but set this explicitly in production.
GOOGLE_ALLOWED_REDIRECT_URIS=

FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Production: https://api.gatewayglobal.africa/api/v1/auth/google/callback

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ggapp.example

# Expo push (mobile): access token from https://expo.dev/settings/access-tokens
# (needed for push tickets to devices; classic push tokens also work without it).
EXPO_ACCESS_TOKEN=

EMAIL_FROM=GG'APP <no-reply@gatewayglobal.africa>

# Transactional email delivery (Resend). Domain must be verified at
# https://resend.com/domains with the gatewayglobal.africa DNS records.
# Leave RESEND_API_KEY empty for local development — email is skipped with a
# logged warning and dev-only reset/verify links are still returned inline.
RESEND_API_KEY=

# Object storage (S3-compatible: Railway Buckets / Cloudflare R2 / AWS S3 / Backblaze B2).
# Leave STORAGE_ENDPOINT empty to keep the legacy behavior of embedding
# attachment data URLs in PostgreSQL (local development only — production must
# enable object storage so clinical documents never live in the database).
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# Optional: if the bucket is publicly readable, set the public base URL to skip
# presigned URLs (e.g. https://<bucket>.r2.dev or the Railway Bucket public URL).
STORAGE_PUBLIC_BASE_URL=
# Presigned GET URL lifetime in seconds (default 900).
STORAGE_PRESIGN_EXPIRES=900
